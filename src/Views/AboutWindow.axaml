<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Chronology.Views.AboutWindow"
        Title="About Chronology"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True">

    <StackPanel Margin="16" Spacing="8">
        <SelectableTextBlock x:Name="TitleText" FontWeight="Bold"
                             Background="Transparent" HorizontalAlignment="Stretch" />
        <SelectableTextBlock x:Name="InfoText"
                             Background="Transparent" HorizontalAlignment="Stretch"
                             TextWrapping="NoWrap" />
        <Button Content="OK" Click="OnOk"
                HorizontalAlignment="Right"
                Margin="0,4,0,0" />
    </StackPanel>
</Window>
