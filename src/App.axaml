<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chronology.App"
             xmlns:local="using:Chronology"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Color x:Key="ErrorColor">OrangeRed</Color>
                    <Color x:Key="GoalMetColor">LimeGreen</Color>
                    <FontFamily x:Key="WindowFontFamily">Inter</FontFamily>
                    <FontFamily x:Key="MonospaceFontFamily">Cascadia Code,Consolas,Menlo,monospace</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <Setter Property="Padding" Value="24,6" />
        </Style>

        <Style Selector="Button.compact">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource WindowFontFamily}" />
        </Style>

        <Style Selector=".monospace">
            <Setter Property="FontFamily" x:SetterTargetType="TextElement" Value="{DynamicResource MonospaceFontFamily}" />
        </Style>
    </Application.Styles>
</Application>
